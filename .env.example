# Anime Reality AI - Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Hardware Settings
MAX_VRAM_GB=8.0
DEVICE=cuda
PRECISION=fp16

# Hugging Face & Model Repositories
HF_HOME=./models/cache
HUGGINGFACE_TOKEN=

# API & Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=*

# Storage & Output Paths
DATASET_ROOT=./datasets
OUTPUT_DIR=./outputs
CHECKPOINT_DIR=./checkpoints
