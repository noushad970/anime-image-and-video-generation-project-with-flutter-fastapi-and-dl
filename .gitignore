# ===================================================
# Anime Reality AI — Comprehensive Git Ignore Rules
# ===================================================

# Python Environments & Caches
.venv/
env/
venv/
ENV/
.env
.env.local
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Large AI Weights & Models (>10MB binary assets)
*.pt
*.pth
*.safetensors
*.bin
*.ckpt
*.onnx
*.tflite
*.engine
*.h5

# Keep model registry configuration
!models/registry.json
!models/**/.gitkeep

# Large Datasets & Media (>50GB local datasets)
datasets/
!datasets/README.md
!datasets/**/.gitkeep

# Output artifacts & Job Results
outputs/
!outputs/README.md
!outputs/**/.gitkeep
checkpoints/
!checkpoints/README.md

# SQLite Local Database
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# Flutter & Dart Build Artifacts
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/.pub-cache/
mobile/.pub/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/build/
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/Pods/
mobile/windows/flutter/ephemeral/
mobile/linux/flutter/ephemeral/
*.apk
*.aab

# IDEs & System Files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
